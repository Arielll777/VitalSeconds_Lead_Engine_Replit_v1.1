# VitalSeconds Lead Engine v1.1 — Replit Secrets / local env
# Copy to .env for local test only. On Replit, set these as Secrets.
# NEVER commit real secrets.

# REQUIRED in production (Replit PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# REQUIRED. Operator sign-in password.
APP_PASSWORD=change-me-to-a-long-random-password

# SQLite is NEVER a silent production fallback.
# Set this ONLY for local pytest / development:
# VITALSECONDS_ALLOW_SQLITE_TEST=1

# Optional export directory (defaults to data/exports)
# VITALSECONDS_EXPORT_DIR=data/exports
