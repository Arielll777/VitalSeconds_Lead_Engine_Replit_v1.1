run = "streamlit run app.py --server.port=8080 --server.address=0.0.0.0 --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=false"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PYTHONPATH = "src"

[deployment]
run = ["sh", "-c", "streamlit run app.py --server.port=$PORT --server.address=0.0.0.0 --server.headless=true"]
